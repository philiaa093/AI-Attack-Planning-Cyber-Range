*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
/build/

# JavaScript dependencies and generated frontend output; keep lockfiles
node_modules/
/dashboards/app/frontend/dist/
*.tsbuildinfo

