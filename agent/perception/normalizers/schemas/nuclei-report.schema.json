{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbl6.invalid/normalizers/nuclei-report.schema.json",
  "title": "Offline Nuclei report envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "report_id", "run_id", "action_id", "target_id", "timestamp_utc", "status", "evidence_refs"],
  "oneOf": [{"required": ["raw_output"]}, {"required": ["scanner_results"]}],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "location": {"type": "string", "minLength": 1, "maxLength": 2048},
    "record": {
      "type": "object",
      "additionalProperties": true,
      "required": ["template-id", "type", "host", "matched-at", "matcher-status", "info"],
      "properties": {
        "template-id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"},
        "type": {"const": "http"},
        "matcher-status": {"type": "boolean"},
        "error": {"const": ""},
        "severity": false,
        "tags": false,
        "info": {
          "type": "object", "additionalProperties": true, "required": ["severity"],
          "properties": {
            "severity": {"enum": ["info", "low", "medium", "high", "critical", "unknown"]},
            "tags": {"type": "array", "items": {"type": "string"}}
          }
        },
        "host": {"$ref": "#/$defs/location"},
        "matched-at": {"$ref": "#/$defs/location"},
        "url": {"$ref": "#/$defs/location"}
      }
    },
    "scannerResult": {
      "allOf": [
        {"$ref": "../contracts/scanner-result.schema.json"},
        {"properties": {
          "source": {"const": "NUCLEI"},
          "endpoint_id": {"type": "null"},
          "finding_type": {"enum": ["sqli", "xss", "path-traversal"]},
          "confidence": {"const": 0.0}
        }}
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {"const": "NUCLEI"},
    "report_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "action_id": {"const": "ACTION-SCAN-002"},
    "target_id": {"type": "string", "pattern": "^lab-[a-z0-9-]+$"},
    "timestamp_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]{1,6})?Z$"},
    "status": {"enum": ["SUCCESS", "PARTIAL", "FAILURE", "DENIED", "ERROR", "TIMEOUT"]},
    "raw_output": {
      "description": "Decoded records, JSON array text, or JSONL text. Text is parsed and each record is validated by the normalizer.",
      "oneOf": [
        {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/record"}},
        {"type": "string", "maxLength": 1048576}
      ]
    },
    "scanner_results": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/scannerResult"}},
    "evidence_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]{1,125}$"}}
  },
  "allOf": [{
    "if": {"properties": {"status": {"enum": ["FAILURE", "DENIED", "ERROR", "TIMEOUT"]}}},
    "then": {"properties": {
      "raw_output": {"oneOf": [{"type": "array", "maxItems": 0}, {"type": "string"}]},
      "scanner_results": {"type": "array", "maxItems": 0}
    }}
  }]
}
